# =============================================================================
# afpro Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no repositório
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
SERVER_PORT=8080
FRONTEND_URL=http://localhost:3000   # URL do frontend Next.js (CORS)

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Asaas (Gateway de Pagamento — ADAPTER REAL) ───────────────────────────────
# Obter em: https://www.asaas.com/
ASAAS_API_KEY=$aact_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3     # Trocar para api.asaas.com em prod
ASAAS_WEBHOOK_TOKEN=seu_token_secreto_aqui           # Configurar no painel Asaas

# ── Clicksign (Assinatura Digital — ADAPTER REAL) ────────────────────────────
# Obter em: https://app.clicksign.com/
CLICKSIGN_ACCESS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com     # Trocar para app.clicksign.com em prod
CLICKSIGN_WEBHOOK_HMAC_KEY=seu_secret_hmac_aqui      # Configurar no painel Clicksign

# ── ZapSign (Assinatura Digital — STUB / Reserva) ────────────────────────────
# Descomentado apenas se trocar o provider
# ZAPSIGN_API_TOKEN=xxxxxxxxxxxxxxxxxxxxx
# ZAPSIGN_BASE_URL=https://api.zapsign.com.br/api/v1
